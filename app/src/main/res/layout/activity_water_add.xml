<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WaterAddActivity"
    android:background="@drawable/bg4">

    <!-- CLOSE BUTTON -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1A365D" />

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvWaterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hydration Status"
        android:textColor="#1A365D"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnClose" />

    <!-- WATER CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMonitor"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="#2D9CDB"
        app:strokeWidth="2dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvWaterTitle">

        <!-- IMAGE BACKGROUND -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/water2"
            android:scaleType="centerCrop"
            android:alpha="0.85" />

        <!-- DARK OVERLAY -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#2F000000"/>

        <!-- CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Volume"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvTotalVolume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ml"
                android:textColor="#FFFFFF"
                android:textSize="52sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <ProgressBar
                android:id="@+id/progressBarWater"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="16dp"
                android:max="2500"
                android:progress="0"
                android:progressTint="#2D9CDB"
                android:backgroundTint="#e8f6fc"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Target: 2,500 ml"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintTop_toBottomOf="@+id/cardMonitor">

        <Button
            android:id="@+id/btnAdd250"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#beebfa"
            android:text="+250\nml"
            android:textAlignment="center"
            android:textColor="#2D9CDB"
            android:textSize="11sp"
            app:cornerRadius="16dp"/>

        <Button
            android:id="@+id/btnAdd500"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#beebfa"
            android:text="+500\nml"
            android:textAlignment="center"
            android:textColor="#2D9CDB"
            android:textSize="11sp"
            app:cornerRadius="16dp"/>

        <Button
            android:id="@+id/btnAdd1000"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#beebfa"
            android:text="+1000\nml"
            android:textAlignment="center"
            android:textColor="#2D9CDB"
            android:textSize="11sp"
            app:cornerRadius="16dp"/>

        <Button
            android:id="@+id/btnCustom"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="#2D9CDB"
            android:text="Custom"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            app:cornerRadius="16dp"/>
    </LinearLayout>

    <!-- SAVE BUTTON -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#7dbed4"
        android:text="Save"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="20dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>