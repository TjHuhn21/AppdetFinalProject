<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg4"
    tools:context=".DashboardFragment">

    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvTodayHeader"
                 android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#000000"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- CALORIES & MACROS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalories"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardUseCompatPadding="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/heronweight"
                    android:scaleType="centerCrop"
                    android:alpha="0.7"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <ProgressBar
                        android:id="@+id/progressCaloriesBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:progress="60"
                        android:progressDrawable="@drawable/custom_calories_progressbar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tvRemainingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2,410"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:layout_constraintStart_toStartOf="@id/progressCaloriesBar"
                        app:layout_constraintEnd_toEndOf="@id/progressCaloriesBar"
                        app:layout_constraintTop_toTopOf="@id/progressCaloriesBar"
                        app:layout_constraintBottom_toTopOf="@id/tvRemainingLabel" />

                    <TextView
                        android:id="@+id/tvRemainingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaining"
                        android:textSize="15sp"
                        android:textColor="#FFFFFF"
                        app:layout_constraintStart_toStartOf="@id/progressCaloriesBar"
                        app:layout_constraintEnd_toEndOf="@id/progressCaloriesBar"
                        app:layout_constraintTop_toBottomOf="@id/tvRemainingValue"
                        app:layout_constraintBottom_toBottomOf="@id/progressCaloriesBar" />

                    <LinearLayout
                        android:id="@+id/layoutCalorieStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="24dp"
                        app:layout_constraintStart_toEndOf="@id/progressCaloriesBar"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <TextView
                            android:id="@+id/tvBaseGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Base Goal: 2,410"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvFoodEaten"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Food: 0"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="8dp"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvProteinLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Protein: 0g / 150g"
                            android:textColor="#FFFFFF"
                            android:layout_marginTop="12dp"
                            android:textSize="12sp" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- WEEKLY HABITS -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeeklyHabits"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#9ed2e8"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/heronzz"
                    android:scaleType="centerCrop"
                    android:alpha="0.35"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weekly Habits"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Log a meal for 5+ days this week."
                        android:textColor="#E0E0E0"
                        android:textSize="14sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="7">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MON"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/circle_done">

                                <TextView
                                    android:id="@+id/tvMon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgMon"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TUE"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvTue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgTue"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WED"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvWed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgWed"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THU"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvThu"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgThu"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FRI"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvFri"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgFri"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SAT"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvSat"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgSat"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SUN"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"/>

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/box_uncheck">

                                <TextView
                                    android:id="@+id/tvSun"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="12"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"/>

                                <!-- CHECK ICON -->
                                <ImageView
                                    android:id="@+id/imgSun"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/baseline_check_circle_24"
                                    android:tint="#11182B"
                                    android:visibility="gone"/>
                            </FrameLayout>
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- STEP COUNTER AND WEIGHT -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCarousel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:overScrollMode="never"/>

        <!--  HYDRATION TRACKER -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHydration"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="#2D9CDB"
            app:strokeWidth="2dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/water2"
                android:scaleType="centerCrop"
                android:alpha="0.6" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#4D000000"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvHydrationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hydration"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateWater"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log"
                    android:minWidth="0dp"
                    android:textColor="#FFFFFF"
                    app:iconTint="#FFFFFF"
                    app:icon="@android:drawable/ic_menu_add"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvWaterCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1200"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/pbWaterProgress"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvHydrationTitle" />

                <TextView
                    android:id="@+id/tvWaterUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="6dp"
                    android:text="ml"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvWaterCount"
                    app:layout_constraintStart_toEndOf="@+id/tvWaterCount" />

                <TextView
                    android:id="@+id/tvWaterTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target: 2,500 ml"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@+id/tvWaterCount"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ProgressBar
                    android:id="@+id/pbWaterProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="2500"
                    android:progress="1200"
                    android:progressTint="#2D9CDB"
                    android:backgroundTint="#80FFFFFF"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- WORKOUT LOG CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWorkouts"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/bgWorkout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/heronzz"
                    android:scaleType="centerCrop"
                    android:alpha="0.5" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000" />

                <LinearLayout
                    android:id="@+id/layoutWorkoutInternal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/layoutWorkoutHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvWorkoutTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Workouts"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogWorkout"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Log"
                            android:minWidth="0dp"
                            android:textColor="#FFFFFF"
                            app:icon="@android:drawable/ic_menu_add"
                            app:iconTint="#FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRecentWorkoutStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No workouts logged today."
                        android:textSize="14sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- WEIGHT PROGRESS CARD
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:id="@+id/layoutWeightInternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/layoutWeightHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvWeightTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weight Progress"
                        style="@style/TEXT"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddWeight"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add"
                        android:minWidth="0dp"
                        android:padding="8dp"
                        app:icon="@android:drawable/ic_input_add"
                        android:textColor="#136F98"
                        app:iconTint="#136F98"/>
                </LinearLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/weightLineChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView-->

        <ImageView
            android:layout_height="100dp"
            android:layout_width="match_parent"
            android:src="@drawable/fly"
            android:layout_marginTop="40dp"
            />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>